{
	"name": "ignite",
	"version": "0.9.0",
	"private": true,
	"description": "A small flame, kept going — an ADHD-friendly, open-source task app.",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check . && tsc --noEmit",
		"gen:icons": "node scripts/gen-icons.mjs",
		"gen:preview": "node scripts/gen-preview.mjs",
		"test": "vitest",
		"test:run": "vitest run"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/malinfossum/ignite.git"
	},
	"author": "Malin Fossum",
	"license": "Apache-2.0",
	"bugs": {
		"url": "https://github.com/malinfossum/ignite/issues"
	},
	"homepage": "https://github.com/malinfossum/ignite#readme",
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/node": "^22.20.5",
		"fake-indexeddb": "^6.2.5",
		"sharp": "^0.35.5",
		"typescript": "7.0.2",
		"vite": "^8.3.2",
		"vitest": "^5.0.3"
	},
	"allowScripts": {
		"sharp@0.34.5": true
	}
}
