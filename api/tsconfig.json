{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2023"],
		"types": ["node"],
		"strict": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": [
		"../worker-configuration.d.ts",
		"src/**/*.ts",
		"scripts/**/*.ts",
		"test/**/*.ts",
		"drizzle.config.ts",
		"../shared/**/*.ts",
		"../vitest.workers.config.ts"
	]
}
