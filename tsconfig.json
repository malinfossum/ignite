{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ESNext", "DOM"],
		"allowJs": true,
		"checkJs": false,
		"strict": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": [
		"src/**/*",
		"shared/**/*",
		"tests/**/*",
		"scripts/**/*",
		"design-system/**/*",
		"*.js",
		"*.mjs"
	],
	"exclude": ["node_modules", "dist"]
}
